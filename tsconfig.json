{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/main.tsx",
    "src/lib/config.ts",
    "src/lib/telegram/client.ts",
    "src/lib/telegram/account-storage.ts",
    "src/lib/telegram/qr-scan.ts",
    "src/lib/telegram/types.ts",
    "src/lib/openchamber/globals.d.ts",
    "src/lib/openchamber/upstream.d.ts",
    "src/vite/telegram-back-button-plugin.ts",
    "vite.config.ts"
  ]
}
